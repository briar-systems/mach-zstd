# Huffman coded literals: tree descriptions, the decode table and the one and four stream decoders (RFC 8878 section 4.2)

use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

use zstd.bits;
use zstd.fse;

# the longest code the format allows
pub val MAX_BITS: u32 = 11;

# one entry of the decode table, indexed by the next MAX_BITS bits of the stream
# ---
# sym:   the literal
# nbits: bits its code occupies
pub rec Entry {
    sym:   u8;
    nbits: u8;
}

# a decode table of 1 << bits entries
pub rec Table {
    bits:    u32;
    entries: [2048]Entry;
}

# decode the interleaved FSE stream of a weight list
# ---
# ret: the weight count, or none if the stream is malformed
fun fse_weights(src: *u8, len: usize, weights: *u8) opt[usize] {
    var ft:   fse.Table;
    val used: opt[usize] = fse.describe(src, len, 12, 6, ?ft);
    if (!sel used.some) { ret opt[usize].none{}; }

    var r: bits.Reverse;
    if (!bits.open(?r, ?src[used.some], len - used.some)) { ret opt[usize].none{}; }

    var s1: usize = fse.start(?ft, ?r);
    var s2: usize = fse.start(?ft, ?r);
    if (r.pos < 0) { ret opt[usize].none{}; }

    var n: usize = 0;
    for {
        if (n + 2 > 255) { ret opt[usize].none{}; }
        weights[n] = ft.entries[s1].sym;
        n          = n + 1;
        s1         = fse.advance(?ft, s1, ?r);
        if (r.pos < 0) {
            weights[n] = ft.entries[s2].sym;
            ret opt[usize].some{n + 1};
        }

        weights[n] = ft.entries[s2].sym;
        n          = n + 1;
        s2         = fse.advance(?ft, s2, ?r);
        if (r.pos < 0) {
            weights[n] = ft.entries[s1].sym;
            ret opt[usize].some{n + 1};
        }
    }
    ret opt[usize].none{};
}

# build the decode table from the weights, deducing the last symbol's weight
fun from_weights(t: *Table, weights: *u8, count: usize) bool {
    var sum: u32   = 0;
    var i:   usize = 0;
    for (i < count) {
        if (weights[i] > 12) { ret false; }
        if (weights[i] != 0) { sum = sum + (1::u32 << (weights[i]::u32 - 1)); }
        i = i + 1;
    }
    if (sum == 0) { ret false; }

    val max_bits: u32 = bits.high_bit(sum) + 1;
    if (max_bits > MAX_BITS) { ret false; }

    val rest: u32 = (1::u32 << max_bits) - sum;
    if ((rest & (rest - 1)) != 0) { ret false; }
    weights[count] = (bits.high_bit(rest) + 1)::u8;

    t.bits = max_bits;
    var at: usize = 0;
    var w:  u32   = 1;
    for (w <= max_bits) {
        val span: usize = 1::usize << (w - 1)::usize;
        var s:    usize = 0;
        for (s <= count) {
            if (weights[s]::u32 == w) {
                var k: usize = 0;
                for (k < span) {
                    t.entries[at + k].sym   = s::u8;
                    t.entries[at + k].nbits = (max_bits + 1 - w)::u8;
                    k                       = k + 1;
                }
                at = at + span;
            }
            s = s + 1;
        }
        w = w + 1;
    }
    ret true;
}

# read a tree description and build its decode table
# ---
# src: the description, which may be followed by the streams
# len: bytes available at src
# t:   table to fill
# ret: bytes the description occupies, or none if it is invalid
pub fun read_tree(src: *u8, len: usize, t: *Table) opt[usize] {
    if (len == 0) { ret opt[usize].none{}; }

    var weights: [256]u8;
    val head:    usize = src[0]::usize;
    var used:    usize = 0;
    var count:   usize = 0;

    if (head < 128) {
        if (head == 0 || 1 + head > len) { ret opt[usize].none{}; }
        val n: opt[usize] = fse_weights(?src[1], head, ?weights[0]);
        if (!sel n.some) { ret opt[usize].none{}; }
        count = n.some;
        used  = 1 + head;
    }
    or {
        count = head - 127;
        used  = 1 + (count + 1) / 2;
        if (used > len) { ret opt[usize].none{}; }

        var i: usize = 0;
        for (i < count) {
            val b: u8 = src[1 + i / 2];
            if (i % 2 == 0) { weights[i] = b >> 4; }
            or              { weights[i] = b & 15; }
            i = i + 1;
        }
    }

    if (!from_weights(t, ?weights[0], count)) { ret opt[usize].none{}; }
    ret opt[usize].some{used};
}

# decode count literals from one stream
# ---
# ret: false if the stream is malformed or not consumed exactly
pub fun decode_stream(t: *Table, src: *u8, len: usize, dst: *u8, count: usize) bool {
    var r: bits.Reverse;
    if (!bits.open(?r, src, len)) { ret false; }

    var i: usize = 0;
    for (i < count) {
        val e: Entry = t.entries[bits.peek(?r, t.bits)::usize];
        dst[i] = e.sym;
        bits.skip(?r, e.nbits::u32);
        if (r.pos < 0) { ret false; }
        i = i + 1;
    }
    ret r.pos == 0;
}

# decode count literals from four streams behind a jump table
# ---
# src: the jump table and the streams
# ret: false if the streams are malformed
pub fun decode_four(t: *Table, src: *u8, len: usize, dst: *u8, count: usize) bool {
    if (len < 6) { ret false; }

    val seg: usize = (count + 3) / 4;
    if (3 * seg > count) { ret false; }

    val s1: usize = bits.le16(src)::usize;
    val s2: usize = bits.le16(?src[2])::usize;
    val s3: usize = bits.le16(?src[4])::usize;
    if (6 + s1 + s2 + s3 >= len) { ret false; }
    val s4: usize = len - 6 - s1 - s2 - s3;

    var at: usize = 6;
    if (!decode_stream(t, ?src[at], s1, dst, seg)) { ret false; }
    at = at + s1;
    if (!decode_stream(t, ?src[at], s2, ?dst[seg], seg)) { ret false; }
    at = at + s2;
    if (!decode_stream(t, ?src[at], s3, ?dst[2 * seg], seg)) { ret false; }
    at = at + s3;
    ret decode_stream(t, ?src[at], s4, ?dst[3 * seg], count - 3 * seg);
}

$if (capability.HOSTED) {
    test huffman__known_literals {
        # weights 4 3 2 0 1 and the deduced 1, so literal 0 is "1", 1 is "01", 2 is "001", 4 is "0000", 5 is "0001"
        val tree: [4]u8 = [4]u8{0x84, 0x43, 0x20, 0x10};
        # literals 0 1 2 4 5 0 behind a marker bit
        val data: [2]u8 = [2]u8{0x03, 0xD2};
        val want: [6]u8 = [6]u8{0, 1, 2, 4, 5, 0};

        var t:    Table;
        val used: opt[usize] = read_tree(?tree[0], 4, ?t);
        if (!sel used.some) { ret 1; }
        if (used.some != 4) { ret 5; }
        if (t.bits != 4)    { ret 2; }

        var out: [6]u8;
        if (!decode_stream(?t, ?data[0], 2, ?out[0], 6)) { ret 3; }

        var i: usize = 0;
        for (i < 6) {
            if (out[i] != want[i]) { ret 4; }
            i = i + 1;
        }
        ret 0;
    }
}
